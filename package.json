{
  "name": "n8n-nodes-figranium",
  "version": "0.6.3",
  "author": {
    "name": "Figranium",
    "email": "asernasr@figranium.dev"
  },
  "description": "Official n8n community node for Figranium. Connect to local or remote Figranium servers to automate tasks with dynamic variable injection and real-time response handling.",
  "keywords": [
    "n8n-community-node-package",
    "figranium",
    "automation"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figranium/n8n-nodes-figranium.git"
  },
  "bugs": {
    "url": "https://github.com/figranium/n8n-nodes-figranium/issues"
  },
  "homepage": "https://figranium.dev",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles \"nodes/**/*.{png,svg}\" \"credentials/**/*.{png,svg}\" dist",
    "lint": "eslint \"nodes/**/*.{ts,js}\" \"credentials/**/*.{ts,js}\" index.ts",
    "lintfix": "eslint \"nodes/**/*.{ts,js}\" \"credentials/**/*.{ts,js}\" index.ts --fix",
    "test": "echo \"No test specified\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "n8n-core": "^1.0.0",
    "n8n-nodes-base": "^1.0.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Figranium/Figranium.node.js"
    ],
    "credentials": [
      "dist/credentials/FigraniumApi.credentials.js"
    ]
  }
}
